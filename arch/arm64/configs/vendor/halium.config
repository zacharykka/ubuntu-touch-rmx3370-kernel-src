# Halium / Ubuntu Touch config fragment for realme GT Neo2 (RMX3370, bitra, 21619)
#
# Merged on top of vendor/kona-perf_defconfig:
#   make vendor/kona-perf_defconfig vendor/halium.config
#
# FORMAT RULE: scripts/kconfig/merge_config.sh treats every line matching
#   ^(# )?CONFIG_[A-Za-z0-9_]*[= ]
# as a directive, so a comment that starts with "# CONFIG_FOO " silently
# UNSETS FOO. In prose, always indent option names:  "#   CONFIG_FOO".
# Verify with:  grep -nE "^(# )?CONFIG_[A-Za-z0-9_]*[= ]" halium.config

# Identify this kernel in uname / dmesg.
CONFIG_LOCALVERSION="-ut-bitra"

# --- systemd (PID 1) hard requirements --------------------------------------
CONFIG_SYSVIPC=y
CONFIG_FHANDLE=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_AUTOFS4_FS=y
CONFIG_FANOTIFY=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# --- namespaces for the Android LXC container -------------------------------
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y

# --- cgroups ----------------------------------------------------------------
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PERF=y

# --- console: /dev/console backed by tty0 (cmdline console=tty0) -------------
# The framebuffer console and hardware console binding stay unset so the VT
# layer can never fight the DRM/SDE display driver.
CONFIG_VT=y
CONFIG_VT_CONSOLE=y

# --- LSM: SELinux is the active major LSM -----------------------------------
# In this tree both SELinux and AppArmor carry LSM_FLAG_EXCLUSIVE
# (security/selinux/hooks.c, security/apparmor/lsm.c). lsm_allowed() lets only
# the FIRST exclusive entry in CONFIG_LSM initialise and silently disables any
# later one, so the order below decides which MAC is live.
#
# SELinux must win. The Android container runs /vendor/bin/vndservicemanager,
# which calls selinux_status_open(true) during startup and abort()s when
# selinuxfs is missing:
#     Check failed: selinux_status_open(true ) >= 0
# Verified on bitra 2026-11-16: with apparmor listed first there is no
# selinuxfs at all (/proc/filesystems), vndservicemanager crash-looped (32
# tombstones), the vendor HIDL servicemanager never came up, the display
# composer never registered its service and Mir blocked in the HWC2 client
# until lightdm killed it after 60s -> black screen.
#
# Cost: AppArmor is compiled in but never initialised, so the Ubuntu Touch
# profiles in /etc/apparmor.d and click app confinement are not enforced.
# The container itself runs lxc.apparmor.profile = unconfined either way.
# Booting with security=apparmor brings AppArmor back but disables SELinux
# (security= turns off every other legacy-major LSM), which breaks the
# container again.
#
# SELINUX_DEVELOP=y => permissive unless enforcing=1 is given: right for
# bring-up, and it keeps the container from being killed by an incomplete
# policy while we still have no working display.
#
# The BPF LSM stays out of the list: its no-op stubs change hook defaults
# (inode_setxattr/inode_removexattr return 0 where 1 is needed to reach the
# capability check for security.* xattrs).
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_DEFAULT_SECURITY_SELINUX=y
# CONFIG_DEFAULT_SECURITY_APPARMOR is not set
CONFIG_LSM="lockdown,yama,loadpin,safesetid,integrity,selinux,smack,tomoyo,apparmor"
CONFIG_SECURITY_SELINUX_BOOTPARAM=y

# --- EROFS with LZ4: stock system/vendor/odm/my_* are LZ4-compressed EROFS ---
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y

# --- firmware ------------------------------------------------------------------
# Keep the user-helper fallback. On SM8250 Halium ports the PIL images
# (adsp/cdsp/slpi .mdt + .bNN segments) are served by the Android
# container ueventd through this fallback.
CONFIG_FW_LOADER_USER_HELPER=y
CONFIG_FW_LOADER_USER_HELPER_FALLBACK=y

# --- USB gadget functions ------------------------------------------------------
# ECM: initrd debug shell (macOS has native CDC-ECM, no RNDIS).
# RNDIS: usb_moded developer mode on the Ubuntu side.
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y

# --- Bluetooth via bluebinder (proxies the Android HAL through /dev/vhci) ------
CONFIG_BT_HCIVHCI=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HIDP=y

# --- power: repowerd libsuspend autosleep backend ------------------------------
CONFIG_PM_AUTOSLEEP=y

# --- networking: lxc-net / waydroid DHCP checksum fixup ------------------------
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y

# --- toolchain: deterministic non-LTO build -------------------------------------
# The base defconfig requests clang LTO + CFI, which Kconfig silently drops
# when the linker is GNU ld. Make the non-LTO result explicit instead.
CONFIG_LTO_NONE=y
# CONFIG_LTO_CLANG is not set
# CONFIG_CFI_CLANG is not set
